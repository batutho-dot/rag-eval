      "output_tokens": 295,
      "cost_usd": 0.0003796,
      "seconds": 1.88
    },
    {
      "id": "q11",
      "retrieved": [
        "taxonomy#0077",
        "taxonomy#0076",
        "taxonomy#0082",
        "esrs#0238",
        "taxonomy#0060"
      ],
      "answer": "An economic activity qualifies as contributing substantially to an environmental objective as an enabling activity when it directly enables other activities to make a substantial contribution to one or more of those objectives, provided it does not lead to a lock-in of assets that undermine long-term environmental goals (considering their economic lifetime) and has a substantial positive environmental impact on a life-cycle basis [1].",
      "stop_reason": "end_turn",
      "input_tokens": 2131,
      "output_tokens": 124,
      "cost_usd": 0.0002751,
      "seconds": 0.99
    },
    {
      "id": "q12",
      "retrieved": [
        "taxonomy#0056",
        "taxonomy#0047",
        "taxonomy#0057",
        "esrs#0224",
        "csrd#0049"
      ],
      "answer": "Under Article 8(2), non-financial undertakings must disclose the proportion of their turnover derived from environmentally sustainable products or services, the proportion of their capital expenditure, and the proportion of their operating expenditure linked to environmentally sustainable assets or processes [1][3].",
      "stop_reason": "end_turn",
      "input_tokens": 2325,
      "output_tokens": 211,
      "cost_usd": 0.000338,
      "seconds": 1.23
    },
    {
      "id": "q13",
      "retrieved": [
        "csrd#0021",
        "csrd#0174",
        "csrd#0173",
        "csrd#0110",
        "taxonomy#0056"
      ],
      "answer": "A non-EU (third-country) undertaking must report if it generates a net turnover of more than EUR 150 million in the Union and has a subsidiary or branch in the EU [1]. For a branch, the threshold is more than EUR 40 million net turnover in the preceding financial year, and the EUR 150 million test applies at group or individual level over the last two consecutive financial years [1][2][3].",
      "stop_reason": "end_turn",
      "input_tokens": 2123,
      "output_tokens": 305,
      "cost_usd": 0.00036480000000000003,
      "seconds": 1.75
    },
    {
      "id": "q14",
      "retrieved": [
        "csrd#0085",
        "csrd#0195",
        "csrd#0231",
        "csrd#0194",
        "csrd#0048"
      ],
      "answer": "The CSRD first requires a **limited assurance** engagement on sustainability reporting, as part of a progressive approach toward higher assurance levels [1].",
      "stop_reason": "end_turn",
      "input_tokens": 2158,
      "output_tokens": 180,
      "cost_usd": 0.0003058,
      "seconds": 1.21
    },
    {
      "id": "q15",
      "retrieved": [
        "csrd#0076",
        "csrd#0214",
        "csrd#0175",
        "csrd#0176",
        "esrs#0001"
      ],
      "answer": "The Commission had to adopt the first set of sustainability reporting standards by 30 June 2023 [1][5].",
      "stop_reason": "end_turn",
      "input_tokens": 2134,
      "output_tokens": 38,
      "cost_usd": 0.0002324,
      "seconds": 0.75
    },
    {
      "id": "q16",
      "retrieved": [
        "csrd#0073",
        "csrd#0076",
        "csrd#0013",
        "csrd#0151",
        "csrd#0250"
      ],
      "answer": "The Commission must review the sustainability reporting standards every three years, to take account of relevant developments, including international standards [2][4].",
      "stop_reason": "end_turn",
      "input_tokens": 2146,
      "output_tokens": 41,
      "cost_usd": 0.00023510000000000002,
      "seconds": 0.78
    },
    {
      "id": "q17",
      "retrieved": [
        "esrs#0001",
        "csrd#0184",
        "csrd#0054",
        "esrs#0002",
        "csrd#0053"
      ],
      "answer": "The Commission takes account of technical advice developed by EFRAG (the European Financial Reporting Advisory Group) [3][4]. Passage [2] also states that the Commission must request an opinion from ESMA, but EFRAG is the body providing the technical advice.",
      "stop_reason": "end_turn",
      "input_tokens": 2286,
      "output_tokens": 87,
      "cost_usd": 0.0002721,
      "seconds": 1.3
    },
    {
      "id": "q18",
      "retrieved": [
        "esrs#0043",
        "esrs#0044",
        "esrs#0045",
        "esrs#0113",
        "esrs#0709"
      ],
      "answer": "The long-term time horizon is more than 5 years, measured from the end of the reporting period [1][2]. Paragraph 78 allows an additional breakdown of the long-term horizon when impacts or actions are expected beyond 5 years [2].",
      "stop_reason": "end_turn",
      "input_tokens": 2164,
      "output_tokens": 80,
      "cost_usd": 0.0002564,
      "seconds": 0.86
    },
